# Supabase (Project Settings → API). Sem estas duas, o app abre em MODO DEMONSTRAÇÃO com dados fictícios.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comunidade exibida (slug da tabela communities)
NEXT_PUBLIC_COMMUNITY_SLUG=riftzada-x1

# URL pública do site (links de e-mail de confirmação e de recuperação de senha)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Coleta diária do preço da Liga (só na Vercel; ver README "Coleta da Liga")
LIGA_SYNC_TOKEN=
FIRECRAWL_API_KEY=
CRON_SECRET=

# Botão "Sugerir melhoria": cria issue no GitHub (só na Vercel; ver README "Sugestões")
GITHUB_TOKEN=
GITHUB_REPO=Kauecsilva/Riftzada
